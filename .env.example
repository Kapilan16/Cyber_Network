# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://cyberuser:cyberpass@postgres:5432/cyberdb

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
# ACCESS_TOKEN_EXPIRE_MINUTES=30         # default: 30 minutes
# REFRESH_TOKEN_EXPIRE_MINUTES=10080     # default: 7 days (60*24*7)

# ── AI / External APIs ────────────────────────────────────────────────────────
AI_API_KEY=your-ai-api-key-here

# ── Embeddings (OpenAI-compatible) ────────────────────────────────────────────
# Leave EMBEDDINGS_API_KEY empty to disable — submissions will still be stored
# with embedding_status=failed. Semantic search returns HTTP 503 when disabled.
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-ada-002
# VECTOR_DIM=1536                        # default: 1536 (must match model output)

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# REDACT_PII=true                        # default: true  (redact emails)
# MAX_SUBMISSION_LENGTH=50000            # default: 50000 chars
